{
  "expo": {
    "name": "ZeroTally",
    "slug": "keep-accounts",
    "version": "1.8.0",
    "orientation": "portrait",
    "scheme": [
      "keep-accounts",
      "com.keepaccounts.app"
    ],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6FBFD"
    },
    "android": {
      "package": "com.keepaccounts.app",
      "versionCode": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#017853"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/with-windows-cmake-path-fix",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
